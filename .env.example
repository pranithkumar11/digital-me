# Elderly & Career Intelligence Hub (.env configuration)

# Server Configuration
PORT=5000
FLASK_ENV=development

# SMTP Email Configuration for Caretaker Alerts
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
ALERT_SENDER_EMAIL=alerts@bytelife.ai
DEFAULT_CARETAKER_EMAIL=caretaker@bytelife.ai

# If SMTP credentials are omitted, the application operates in resilient
# Simulated Dispatch Mode, logging alert payloads to data/alerts_log.json.
